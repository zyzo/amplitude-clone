{
  "name": "minimal-analytics-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run dashboard:build",
    "dashboard:dev": "vite --config dashboard/vite.config.ts",
    "dashboard:build": "tsc -p dashboard/tsconfig.json && vite build --config dashboard/vite.config.ts",
    "dashboard:test": "vitest run --config dashboard/vite.config.ts",
    "dev": "docker compose -f compose.dev.yaml up --build",
    "dev:server": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "worker": "node dist/src/worker.js",
    "events:demo": "node scripts/send-test-events.mjs",
    "start": "node dist/src/server.js",
    "migrate": "node dist/src/migrate.js",
    "test": "npm run build && node --test dist/test/*.test.js && npm run dashboard:test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.2",
    "@tanstack/react-query": "^5.104.0",
    "fastify": "^5.6.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
